# Banco de dados PostgreSQL — OPCIONAL.
# Usado apenas pela rota /api/health. Sem esta variável o site funciona
# normalmente (a rota responde "not-configured").
# Exemplo local:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# URL pública do site (opcional — usada para Open Graph/social share).
# Na Vercel, https://seu-dominio.com.br quando configurar o domínio.
NEXT_PUBLIC_SITE_URL=""
